LUNORX_BACKEND_URL=https://api.lunorx.xyz
# Website base for share links (https://play.lunorx.xyz/s/<token>). Set it to point links at another host.
LUNORX_SHARE_BASE=https://play.lunorx.xyz

# Optional: the backend's Turnstile challenge page, framed by the sign-in form. Unset: no antibot step.
# Set it only when the backend has LUNORX_TURNSTILE_SECRET, or sign-in will be refused. Also add its origin to
# frame-src in src-tauri/tauri.conf.json.
# NEXT_PUBLIC_ANTIBOT_URL=https://api.lunorx.xyz/antibot

# Optional: Terms of Service and Privacy Policy links on the sign-in screen. Defaults: https://www.lunorx.xyz/legal/terms/ and
# https://www.lunorx.xyz/legal/privacy/. Another host must also be allowed under opener:allow-open-url in capabilities/default.json.
# NEXT_PUBLIC_TERMS_URL=https://www.lunorx.xyz/legal/terms/
# NEXT_PUBLIC_PRIVACY_URL=https://www.lunorx.xyz/legal/privacy/
